<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xzkj.hv2.auth.SysUserMapper">

    <sql id="columns">
        ID, USERNAME, PASSWORD_HASH, DISPLAY_NAME, STATUS, CREATED_AT, LAST_LOGIN_AT
    </sql>

    <select id="findByUsername" resultType="com.xzkj.hv2.auth.SysUser">
        SELECT <include refid="columns"/> FROM SYS_USER WHERE USERNAME = #{username}
    </select>

    <select id="findById" resultType="com.xzkj.hv2.auth.SysUser">
        SELECT <include refid="columns"/> FROM SYS_USER WHERE ID = #{id}
    </select>

    <update id="updateLastLoginAt">
        UPDATE SYS_USER SET LAST_LOGIN_AT = LOCALTIMESTAMP(0) WHERE ID = #{id}
    </update>
</mapper>
